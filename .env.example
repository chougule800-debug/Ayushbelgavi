# ============================================================================
# AFI Belagavi — environment configuration
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# ============================================================================

# --- Supabase (required) -----------------------------------------------------
# Find these in the Supabase Dashboard → Project Settings → API.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_anon_key
# The service-role key is used ONLY server-side (server.js). It MUST NEVER be
# exposed to the browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Server (optional) -------------------------------------------------------
PORT=3000
